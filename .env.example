# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Groq API key (https://console.groq.com/keys). Required for cdm_rag/llm_client.py and
# scripts/smoke_test.py.
GROQ_API_KEY=

# Groq model id. No default is hardcoded anywhere in the code -- if this is unset or empty,
# llm_client.chat() raises immediately rather than silently falling back to a model that may be
# deprecated or unavailable on your account.
#   openai/gpt-oss-20b is a smaller/faster fallback available on the same Groq account.
LLM_MODEL=openai/gpt-oss-120b

# Optional, both unset by default (cdm_rag/demo_guard.py). Only relevant for a public demo
# deployment (see README's "Running with Docker" / Render sections); local dev and Docker usage
# are completely unaffected unless these are explicitly set. Neither one touches /health or
# /entities/{name} -- only POST /ask.

# When set, POST /ask requires a matching "X-Demo-Key: <value>" header, else 401.
DEMO_ACCESS_KEY=

# When set to a positive integer, POST /ask is capped to that many requests per rolling hour,
# globally across all callers (a single in-memory counter -- not distributed, not persisted
# across restarts; see demo_guard.py). 429s once exceeded.
DEMO_RATE_LIMIT_PER_HOUR=
